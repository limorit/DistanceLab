<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenCVDistanceLab.App.ScaleInputDialog"
        Title="设置比例尺" Width="450" Height="285" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto">
    <StackPanel Spacing="4">
      <TextBlock Text="设置实际标尺长度" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="输入图中标尺所代表的真实长度，应用后将用于距离与应变计算。"
                 TextWrapping="Wrap" Classes="muted" />
    </StackPanel>
    <Border Grid.Row="1" Margin="0,16,0,18" Padding="12,9"
            Background="#160A84FF" CornerRadius="8">
      <TextBlock x:Name="PixelLengthText" Foreground="#0A84FF" FontWeight="SemiBold" />
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="2*,14,*">
      <StackPanel Spacing="6">
        <TextBlock Text="实际长度" Classes="muted" />
        <TextBox x:Name="LengthBox" FontSize="15" PlaceholderText="例如 100" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="6">
        <TextBlock Text="单位" Classes="muted" />
        <ComboBox x:Name="UnitBox" IsEditable="True" FontSize="15">
          <ComboBoxItem Content="μm" />
          <ComboBoxItem Content="mm" />
          <ComboBoxItem Content="nm" />
          <ComboBoxItem Content="px" />
        </ComboBox>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="4" Margin="0,22,0,0" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8">
      <Button Content="取消" MinWidth="86" IsCancel="True" Click="Cancel_Click" />
      <Button Content="应用比例尺" MinWidth="116" Classes="primary"
              IsDefault="True" Click="Apply_Click" />
    </StackPanel>
  </Grid>
</Window>
